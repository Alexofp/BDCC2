bones/2/position = Vector3(2.9042639e-08, 0.09612138, 0.026290748)
bones/3/position = Vector3(-0.019512374, 0.08875376, 0.02365237)
bones/4/rotation = Quaternion(0.251698, 5.464884e-07, -1.8491319e-07, 0.96780586)
bones/5/position = Vector3(0.019512426, 0.088753864, 0.023652311)
bones/6/position = Vector3(0.03022463, 0.072746985, 0.015915517)
bones/6/rotation = Quaternion(0.251698, 5.464884e-07, -1.8491319e-07, 0.96780586)
bones/7/rotation = Quaternion(-1.7735088e-07, 0.97231483, 0.2336746, -1.8120421e-06)
bones/9/position = Vector3(-2.758723e-14, 0.02072287, 1.7829462e-08)
