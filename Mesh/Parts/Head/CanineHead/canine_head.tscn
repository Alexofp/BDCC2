[node name="Skeleton3D" parent="MyCanineHeadRig" index="0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.016, -0.01)
bones/1/rotation = Quaternion(1.7584181e-06, 0.547932, 0.8365229, 1.1517811e-06)
bones/2/position = Vector3(1.2231507e-07, 0.10440607, 0.029094074)
bones/3/position = Vector3(-0.019512262, 0.09553168, 0.025880221)
bones/4/position = Vector3(-0.03158062, 0.07619903, 0.01794443)
bones/4/rotation = Quaternion(0.20406462, 2.0586772e-06, -4.3303527e-07, 0.9789575)
bones/5/position = Vector3(0.01951252, 0.095531784, 0.025880143)
bones/6/position = Vector3(0.031580795, 0.07619903, 0.017944165)
bones/6/rotation = Quaternion(0.20406462, 2.0586772e-06, -4.3303527e-07, 0.9789575)
bones/7/rotation = Quaternion(1.5107372e-07, 0.9815804, 0.19105, -3.3504891e-06)
bones/9/position = Vector3(7.7801586e-15, 0.03027944, 5.383036e-10)
bones/9/rotation = Quaternion(0.083328046, -2.8827553e-06, -4.542911e-07, 0.9965222)
bones/10/rotation = Quaternion(0.46572477, 0.5248155, 0.56790376, 0.43029585)
