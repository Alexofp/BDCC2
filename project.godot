; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[BDCC2]

precompile_shaders=false

[application]

config/name="BDCC2"
config/version="0.0.1"
run/main_scene="uid://bdtwkbjfc2yjm"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=120
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bpocxbhjwlrp6"

[autoload]

GlobalRegistry="*res://GlobalRegistry.gd"
Console="*uid://ouiu5xh1cs8n"
LoadingScreen="*res://UI/LoadingScreen/LoadingScreen.tscn"
OPTIONS="*res://Game/Settings/GlobalSettings.gd"
ThreadedResourceLoader="*res://Util/ThreadedResourceLoader/ThreadedResourceLoader.gd"
GI="*res://Game/GameInteractor/game_interactor.tscn"
DebugDraw="*res://addons/zylann.debug_draw/debug_draw.gd"
DebugMenu="*uid://cggqb75a8w8r"
ProcessBalancer="*res://Game/Systems/ProcessBalancer/ProcessBalancer.gd"
UIHandler="*res://UI/UIHandler/UIHandler.gd"
GameChat="*res://UI/FullScreenChat/GameChat.gd"
Network="*res://Game/Multiplayer/Network.gd"
Noray="*uid://gu4bv4tgms3x"
PacketHandshake="*uid://tt3j25a05n7c"
NetworkTime="*uid://cnqdxyjptkfvp"
NetworkTimeSynchronizer="*uid://5rmn2ik3kjo8"
NetworkRollback="*uid://gas743comroj"
NetworkEvents="*uid://bdmobxxptryj0"
NetworkPerformance="*uid://cqgf7aqmjfoa3"
WindowTiler="*uid://cmqjajhjgffm1"
CameraSystem="*res://Game/Systems/Camera/CameraSystem.gd"
CumManager="*res://Mesh/Cum/CumManager.gd"
AsyncUtil="*uid://c2q042l10cyju"

[display]

window/vsync/vsync_mode=0

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://addons/bdcc2gizmos/plugin.cfg", "res://addons/console/plugin.cfg", "res://addons/debug_menu/plugin.cfg", "res://addons/godot-polyliner/plugin.cfg", "res://addons/myeasycollisionmakerbutton/plugin.cfg", "res://addons/netfox.extras/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox.noray/plugin.cfg", "res://addons/netfox/plugin.cfg", "res://addons/nodetunnel/plugin.cfg", "res://addons/thread_pool/plugin.cfg", "res://addons/version_bumper/plugin.cfg", "res://addons/wigglebone/plugin.cfg")

[global_group]

Networked="Automatically spawn/despawn/sync this node over the network"
Navmesh=""

