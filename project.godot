[netfox]

time/tickrate=20
time/sync_to_physics=true

[physics]

common/physics_ticks_per_second=20
common/max_physics_steps_per_frame=1
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

