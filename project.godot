reflections/reflection_atlas/reflection_size.mobile=32
reflections/reflection_atlas/reflection_count=16
environment/ssil/quality=4
environment/ssil/adaptive_target=1.0
environment/ssil/fadeout_to=100.0
occlusion_culling/occlusion_rays_per_thread=32
environment/glow/upscale_mode=0
global_illumination/sdfgi/probe_ray_count=5
global_illumination/sdfgi/frames_to_update_lights=4
